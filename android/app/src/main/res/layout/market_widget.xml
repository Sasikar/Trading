<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP: BTC | refresh | ETH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/btc_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_btc" />
                <TextView
                    android:id="@+id/btc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="BTC"
                    android:textColor="#F7931A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/refresh"
                android:layout_width="38dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="↻"
                android:textColor="#16C784"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/eth_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:text="ETH"
                    android:textColor="#627EEA"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
                <ImageView
                    android:id="@+id/eth_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_eth" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRICES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/eth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#252A32" />

        <!-- BOTTOM: SOL | Fear & Greed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/sol_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_sol" />
                <TextView
                    android:id="@+id/sol_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="SOL"
                    android:textColor="#9945FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/fomo_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_lightning" />
                <TextView
                    android:id="@+id/fomo_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Fear &amp; Greed"
                    android:textColor="#FFC107"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- VALUES: SOL price | F&G score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/fomo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:paddingEnd="4dp"
                android:text="—"
                android:textColor="#16C784"
                android:textSize="25sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Small status line; does not alter the existing market layout. -->
        <TextView
            android:id="@+id/last_refreshed"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:text="Last refreshed —"
            android:textColor="#747B86"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
