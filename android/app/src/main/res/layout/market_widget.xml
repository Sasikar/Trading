<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="36dp">
        <ImageView android:id="@+id/btc_icon" android:src="@drawable/ic_btc" android:layout_width="28dp" android:layout_height="28dp" />
        <TextView android:text="BTC" android:textColor="#F7931A" android:textSize="16sp" android:textStyle="bold" android:layout_marginLeft="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/refresh" android:text="↻" android:textColor="#16C784" android:textSize="28sp" android:gravity="center" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" />
        <ImageView android:id="@+id/eth_icon" android:src="@drawable/ic_eth" android:layout_width="28dp" android:layout_height="28dp" />
        <TextView android:text="ETH" android:textColor="#627EEA" android:textSize="16sp" android:textStyle="bold" android:layout_marginLeft="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="40dp">
        <TextView android:id="@+id/btc" android:text="$—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <TextView android:id="@+id/eth" android:text="$—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:gravity="right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#252A32" android:text="" />

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="76dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="36dp">
                <ImageView android:id="@+id/sol_icon" android:src="@drawable/ic_sol" android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:text="SOL" android:textColor="#9945FF" android:textSize="16sp" android:textStyle="bold" android:layout_marginLeft="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/sol" android:text="$—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="40dp" />
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="32dp">
        <ImageView android:id="@+id/fomo_icon" android:src="@drawable/ic_lightning" android:layout_width="26dp" android:layout_height="26dp" />
        <TextView android:id="@+id/fomo" android:text="—" android:textColor="#16C784" android:textSize="24sp" android:textStyle="bold" android:layout_marginLeft="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
