<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/btc_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/ic_btc" />

    <TextView
        android:id="@+id/btc_label"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_toEndOf="@id/btc_icon"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:text="BTC"
        android:textColor="#F7931A"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/refresh"
        android:layout_width="58dp"
        android:layout_height="72dp"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="↻"
        android:textColor="#16C784"
        android:textSize="46sp" />

    <ImageView
        android:id="@+id/eth_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_eth" />

    <TextView
        android:id="@+id/eth_label"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_toStartOf="@id/eth_icon"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:text="ETH"
        android:textColor="#627EEA"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btc"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_below="@id/btc_icon"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="$—"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eth"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_below="@id/eth_icon"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical|end"
        android:includeFontPadding="false"
        android:text="$—"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/btc"
        android:layout_marginTop="0dp"
        android:background="#252A32" />

    <ImageView
        android:id="@+id/sol_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_below="@id/divider"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_sol" />

    <TextView
        android:id="@+id/sol_label"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_toEndOf="@id/sol_icon"
        android:layout_alignTop="@id/sol_icon"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:text="SOL"
        android:textColor="#9945FF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/fomo_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@id/divider"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_lightning" />

    <TextView
        android:id="@+id/fomo_label"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_toStartOf="@id/fomo_icon"
        android:layout_alignTop="@id/fomo_icon"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:text="Fear &amp; Greed"
        android:textColor="#FFC107"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sol"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_below="@id/sol_icon"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="$—"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fomo"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_below="@id/fomo_icon"
        android:layout_toStartOf="@id/fomo_icon"
        android:layout_marginEnd="0dp"
        android:gravity="center_vertical|end"
        android:includeFontPadding="false"
        android:text="—"
        android:textColor="#16C784"
        android:textSize="48sp"
        android:textStyle="bold" />
</RelativeLayout>
