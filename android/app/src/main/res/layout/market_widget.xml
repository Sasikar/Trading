<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP: BTC | refresh | ETH -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/btc_icon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_btc" />
                <TextView
                    android:id="@+id/btc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:text="BTC"
                    android:textColor="#F7931A"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/refresh"
                android:layout_width="58dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="↻"
                android:textColor="#16C784"
                android:textSize="46sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/eth_label"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_vertical|end"
                    android:text="ETH"
                    android:textColor="#627EEA"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/eth_icon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_eth" />
            </LinearLayout>
        </FrameLayout>

        <!-- PRICES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/eth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#252A32"
            android:text="" />

        <!-- BOTTOM HEADERS: SOL | Fear & Greed -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/sol_icon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_sol" />
                <TextView
                    android:id="@+id/sol_label"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:text="SOL"
                    android:textColor="#9945FF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/fomo_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_lightning" />
                <TextView
                    android:id="@+id/fomo_label"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:text="Fear &amp; Greed"
                    android:textColor="#FFC107"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- VALUES: SOL price | F&G score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:text="$—"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/fomo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="60dp"
                android:text="—"
                android:textColor="#16C784"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
